# HTTP server
ServerPort=8080

# Debug server (separate port; never expose publicly).
# Hosts BOTH /debug/pprof/* and Prometheus /metrics.
PprofPort=6060

# Logging — debug | info | warn | error
LogLevel=info

# Primary database — used for all writes and as fallback for reads
DatabaseURL=postgres://postgres:postgres@localhost:5432/urlshortner?sslmode=disable

# Read replica database — OPTIONAL.
# Empty/absent → no replica, all reads go to primary.
# When set, reads cascade replica → primary via the breaker-protected Router.
ReadDatabaseURL=postgres://postgres:postgres@localhost:5432/urlshortner?sslmode=disable

# Cleanup cron
CleanUpInterval=2m
URLUnusedThreshold=2h

# Redis — backs the distributed rate limiter so multiple replicas share a
# single quota. Run locally with:
#   docker run -d --name redis -p 6379:6379 redis:latest
RedisURL=redis://localhost:6379/0

# Per-call Redis timeout. On timeout/error the limiter fails open (allows the
# request) so a Redis blip cannot stall the API.
RedisOpTimeout=100ms

# Rate limiter — fixed window per client IP. Window resets on a clock tick;
# RateLimitPerMinute is the cap inside one window.
RateLimitPerMinute=100
RateLimitWindow=1m

# Observability — service identity (used as resource attrs on traces and as
# the otelgin span name source).
ServiceName=url-shortener
ServiceVersion=dev

# OpenTelemetry — OTLP HTTP trace exporter. Empty endpoint = tracing disabled
# (a no-op tracer is installed; otelpgx/redisotel/otelgin become free).
# Examples:
#   OtelExporterEndpoint=http://localhost:4318       # local OTel collector / Jaeger / Tempo
#   OtelExporterEndpoint=https://otel.example.com:4318/v1/traces
OtelExporterEndpoint=
# Force plaintext when the URL is http:// — the SDK derives this from the
# scheme, but some collectors require it explicit. Default false.
OtelExporterInsecure=false
# Sampling ratio in [0,1]. 1.0 = sample every span, 0.1 = 10%, 0 = drop all.
OtelSampleRatio=1.0
